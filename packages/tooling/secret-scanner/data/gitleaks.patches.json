{
    "allowlists": [
        {
            "description": "Placeholder tokens that look like secrets but clearly aren't (generic-api-key).",
            "targetRules": ["generic-api-key"],
            "regexTarget": "secret",
            "stopwords": [
                "changeme",
                "placeholder",
                "your-secret",
                "your_secret",
                "your-token",
                "your_token",
                "your-api-key",
                "your_api_key",
                "your-password",
                "your_password",
                "your-key",
                "your_key",
                "replace-me",
                "replace_me",
                "not-a-real",
                "not_a_real",
                "redacted",
                "fake-secret",
                "fake_secret",
                "dummy-secret",
                "dummy_secret",
                "example-secret",
                "example_secret",
                "xxxxxx",
                "yyyyyy",
                "zzzzzz",
                "0000000",
                "test-token",
                "test_token",
                "INSERT_YOUR",
                "REPLACE_WITH",
                "REPLACE_ME",
                "PASTE_YOUR",
                "PASTE_HERE",
                "ADD_YOUR",
                "SET_YOUR",
                "TYPE_YOUR",
                "ENTER_YOUR",
                "FILL_YOUR",
                "<YOUR_",
                "<your_",
                "<your-",
                "NEXT_PUBLIC_PLACEHOLDER",
                "NUXT_PUBLIC_PLACEHOLDER",
                "VITE_PLACEHOLDER",
                "REACT_APP_PLACEHOLDER",
                "PUBLIC_PLACEHOLDER"
            ]
        },
        {
            "description": "Template / interpolation syntax that embeds variables, not secrets.",
            "targetRules": ["generic-api-key"],
            "regexTarget": "secret",
            "regexes": [
                "\\$\\{[^}]*\\}",
                "\\{\\{\\s*[^}]+\\s*\\}\\}",
                "(?i)^vault://",
                "(?i)^\\$env:",
                "(?i)^arn:aws:",
                "^\\$[a-zA-Z_][a-zA-Z0-9_.]*$",
                "(?i)^Astro\\.(?:props|locals)\\.",
                "^[a-zA-Z_][a-zA-Z0-9_.]*(?:\\?\\.[a-zA-Z0-9_]+)+$",
                "(?i)^(?:process\\.env|import\\.meta\\.env)\\.[A-Z0-9_]+$"
            ]
        }
    ]
}
