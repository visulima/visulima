{
    "name": "@visulima/cron-parser",
    "version": "2.0.0",
    "description": "Fast, zero-dependency cron expression parser with time zone and DST support, for Node.js, Bun and Workers",
    "keywords": [
        "cron",
        "crontab",
        "parser",
        "schedule",
        "scheduler",
        "timezone",
        "dst",
        "esm",
        "visulima"
    ],
    "homepage": "https://visulima.com/packages/cron-parser",
    "bugs": "https://github.com/visulima/visulima/issues",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/visulima/visulima.git",
        "directory": "packages/workflow/cron-parser"
    },
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/prisis"
        },
        {
            "type": "consulting",
            "url": "https://anolilab.com/support"
        }
    ],
    "license": "MIT",
    "author": {
        "name": "Daniel Bannert",
        "email": "d.bannert@anolilab.de"
    },
    "sideEffects": false,
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./cloudflare": {
            "types": "./dist/cloudflare.d.ts",
            "default": "./dist/cloudflare.js"
        },
        "./file": {
            "types": "./dist/file.d.ts",
            "default": "./dist/file.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "README.md",
        "CHANGELOG.md"
    ],
    "scripts": {
        "build": "packem build --development",
        "build:prod": "packem build --production",
        "clean": "rimraf node_modules dist .eslintcache",
        "dev": "pnpm run build --watch",
        "fallow:audit": "fallow audit",
        "fallow:dead-code": "fallow dead-code",
        "fallow:health": "fallow health --report-only",
        "lint:attw": "attw --pack --profile esm-only --ignore-rules internal-resolution-error",
        "lint:eslint": "eslint . --cache --concurrency auto",
        "lint:eslint:fix": "eslint . --cache --concurrency auto --fix",
        "lint:package-json": "publint --strict",
        "lint:prettier": "prettier --config=prettier.config.js --check .",
        "lint:prettier:fix": "prettier --config=prettier.config.js --write .",
        "lint:types": "tsc --noEmit",
        "size": "node scripts/bundle-size.mjs",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "test:runtimes": "node scripts/runtime-smoke.mjs && bun scripts/runtime-smoke.mjs",
        "test:ui": "vitest --ui --coverage.enabled=true",
        "test:watch": "vitest",
        "test:workerd": "vitest run --config vitest.workerd.config.ts"
    },
    "devDependencies": {
        "@anolilab/eslint-config": "catalog:lint",
        "@anolilab/prettier-config": "catalog:lint",
        "@anolilab/semantic-release-pnpm": "catalog:dev",
        "@anolilab/semantic-release-preset": "catalog:dev",
        "@arethetypeswrong/cli": "catalog:dev",
        "@cloudflare/vitest-pool-workers": "catalog:test",
        "@secretlint/secretlint-rule-preset-recommend": "catalog:lint",
        "@total-typescript/ts-reset": "catalog:dev",
        "@types/luxon": "catalog:types",
        "@types/node": "catalog:types",
        "@visulima/packem": "catalog:dev",
        "@vitest/coverage-v8": "catalog:test",
        "@vitest/ui": "catalog:test",
        "conventional-changelog-conventionalcommits": "catalog:dev",
        "cron-parser": "catalog:test",
        "esbuild": "catalog:build",
        "eslint": "catalog:lint",
        "fallow": "catalog:lint",
        "luxon": "catalog:test",
        "prettier": "catalog:lint",
        "publint": "catalog:dev",
        "rimraf": "catalog:node",
        "secretlint": "catalog:lint",
        "semantic-release": "catalog:cli",
        "temporal-polyfill": "catalog:test",
        "typescript": "catalog:tsc",
        "vitest": "catalog:test"
    },
    "engines": {
        "node": "^22.14.0 || >=24.10.0"
    },
    "publishConfig": {
        "access": "public",
        "provenance": true
    }
}
